{"nodes": [{"id": "claude_skills_fpga_skill_fpga_development", "label": "FPGA Development Guidelines", "file_type": "document", "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L1-L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FPGA development guidelines covering Vivado, SystemVerilog, modular design, timing closure, AXI interfaces, and hardware optimization."}, {"id": "claude_skills_fpga_skill_synchronous_design_principles", "label": "Synchronous Design Principles", "file_type": "rationale", "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L20-L26", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prioritize single clock domains to simplify timing analysis, favor synchronous reset over asynchronous reset for predictable behavior, and use synchronizers or FIFOs for safe clock domain crossing."}, {"id": "claude_skills_fpga_skill_timing_closure_and_constraints", "label": "Timing Closure and Constraints", "file_type": "rationale", "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L27-L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Establish XDC timing constraints early, review Static Timing Analysis reports, and resolve violations via pipeline stages, logic optimization, or multi-cycle path constraints."}, {"id": "claude_skills_fpga_skill_resource_and_power_optimization", "label": "Resource and Power Optimization", "file_type": "rationale", "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L35-L49", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimize LUTs, FFs, and BRAM (including reg[] RAM inference), use Vivado IP cores (AXI, DSP, memory controllers), and apply clock gating and power-aware synthesis."}, {"id": "claude_skills_fpga_skill_verification_and_debugging", "label": "FPGA Simulation and ILA Verification", "file_type": "concept", "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L50-L57", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use self-checking testbenches, SystemVerilog assertions, behavioral and post-synthesis simulation, and Integrated Logic Analyzer (ILA) probing for real-time debugging."}, {"id": "claude_skills_fpga_skill_axi_dma_latency_optimization", "label": "AXI, DMA, and Latency Optimization", "file_type": "concept", "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L58-L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ensure AXI read/write handshake compliance, configure DMA burst transfers for throughput, and place fine-tuned pipeline stages to balance latency vs. throughput."}], "edges": [{"source": "claude_skills_fpga_skill_fpga_development", "target": "claude_skills_fpga_skill_synchronous_design_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L20-L26", "weight": 1.0}, {"source": "claude_skills_fpga_skill_fpga_development", "target": "claude_skills_fpga_skill_timing_closure_and_constraints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L27-L34", "weight": 1.0}, {"source": "claude_skills_fpga_skill_fpga_development", "target": "claude_skills_fpga_skill_resource_and_power_optimization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/fpga/SKILL.md", "source_location": "L35-L49", "weight": 1.0}, {"source": "claude_skills_fpga_skill_fpga_development", "target": "claude_skills_fpga_skill_verification_and_debugging", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/fpga/SKILL.md", "source_location":